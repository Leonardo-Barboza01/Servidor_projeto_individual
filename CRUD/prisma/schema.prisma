generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Molde categoria
model Categoria {
  id   String @id @default(uuid())
  nome String

  data_criacao   DateTime @default(now())
  data_alteracao DateTime @updatedAt

  animais  Animal[]
  produtos Produto[]

  @@map("categorias")
}

// Molde animal 
model Animal {
  id     String  @id @default(uuid())
  nome   String
  raca   String
  peso   Float
  status Boolean

  data_criacao   DateTime @default(now())
  data_alteracao DateTime @updatedAt

  categoria   Categoria @relation(fields: [idCategoria], references: [id])
  idCategoria String

  @@map("animais")
}

// Model Produtos
model Produto {
  id        String  @id @default(uuid())
  nome      String
  preco     Float
  descricao String
  estoque   Int     @default(0)
  status    Boolean @default(true)

  data_criacao   DateTime @default(now())
  data_alteracao DateTime @updatedAt

  categoria   Categoria @relation(fields: [idCategoria], references: [id])
  idCategoria String

  @@map("produtos")
}
